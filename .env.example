# Docker Compose environment — copy to project root as .env
#   copy .env.example .env
# Then fill in real values before: docker compose up --build -d
#
# You can also copy from apps/api/.env and add the VITE_* lines below.

# ── API (required) ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
APP_ENV=production

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
JWT_SECRET=pick-a-long-random-password-at-least-32-characters

# Comma-separated browser origins allowed to call the API (required for hosted website)
# Example: http://localhost:5173,https://payslip-portal-xxx.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Optional — only if using Supabase Storage features
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── WhatsApp / DoubleTick (required for payslip dispatch) ────────────────────
DOUBLETICK_API_KEY=your-doubletick-api-key
WABA_PHONE_NUMBER_ID=919876543210
DOUBLETICK_WEBHOOK_SECRET=your-webhook-secret-matching-doubletick

# ── Web build (required — same Supabase project as above) ────────────────────
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional: bulk dispatch tuning ───────────────────────────────────────────
# DISPATCH_WORKERS=30
# DISPATCH_ITEM_DELAY_MS=50

# ── Local Postgres only (when using --profile local-db) ──────────────────────
# Leave DATABASE_URL unset or comment it out to use the bundled db container:
# DATABASE_URL=postgres://postgres:password@db:5432/nippon_hrms?sslmode=disable
