datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums

enum ReporterType {
  EMPLOYEE
  SECURITY
  CONSULTANT
  VENDOR
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum TicketStatus {
  NEW
  UNDER_REVIEW
  PENDING_INFORMATION
  MATERIALS_ADDED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum TransactionType {
  STOCK_IN
  RESERVATION
  RELEASE
  CONSUMPTION
  ADJUSTMENT
}

enum MaterialStatus {
  ADDED
  RESERVED
  CONSUMED
  RELEASED
}

enum CostType {
  MATERIAL
  LABOUR
}

enum ActivityType {
  ASSIGNED
  UNASSIGNED
  COST_ADDED
  CLOSED
  REOPENED
}

enum MaintenanceRole {
  ADMIN
  BRANCH
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Models

model Location {
  id         String   @id @default(cuid())
  name       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tickets Ticket[]
  maintenance_branch MaintenanceBranch?
}

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  type       String // "TICKET" or "INVENTORY"
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tickets         Ticket[]
  inventory_items InventoryItem[]
}

model Ticket {
  id            String         @id @default(cuid())
  ticket_number String         @unique // e.g. MT-2026-0001
  status        TicketStatus   @default(NEW)
  priority      TicketPriority

  reporter_name String
  reporter_type ReporterType

  location_id String
  location    Location @relation(fields: [location_id], references: [id])

  branch_id String?
  branch    MaintenanceBranch? @relation(fields: [branch_id], references: [id])

  category_id String
  category    Category @relation(fields: [category_id], references: [id])

  description String

  image_url        String?
  image_caption    String?
  source_phone     String
  employee_id      String?
  source_message_id String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  status_history TicketStatusHistory[]
  materials      TicketMaterial[]
  assignee_id    String?
  assignee       MaintenanceAssignee? @relation("CurrentTicketAssignee", fields: [assignee_id], references: [id])
  assignments    TicketAssignment[]
  costs          TicketCost[]
  activities     TicketActivity[]
  transfers      TicketTransfer[]

  @@index([status, created_at])
  @@index([assignee_id, status, created_at])
  @@index([branch_id, status, created_at])
}

model MaintenanceBranch {
  id          String   @id @default(cuid())
  location_id String   @unique
  location    Location @relation(fields: [location_id], references: [id])
  name        String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  account          MaintenanceAccount?
  tickets          Ticket[]
  outgoingTransfers TicketTransfer[] @relation("TransferSource")
  incomingTransfers TicketTransfer[] @relation("TransferDestination")

  @@index([is_active, name])
}

model MaintenanceAccount {
  id             String          @id @default(cuid())
  email          String?         @unique
  login_key      String?         @unique
  secret_hash    String
  role           MaintenanceRole
  branch_id      String?         @unique
  branch         MaintenanceBranch? @relation(fields: [branch_id], references: [id])
  is_active      Boolean         @default(true)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  requestedTransfers TicketTransfer[] @relation("TransferRequester")

  @@index([role, is_active])
}

model TicketTransfer {
  id                   String         @id @default(cuid())
  ticket_id            String
  ticket               Ticket         @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  source_branch_id     String
  source_branch        MaintenanceBranch @relation("TransferSource", fields: [source_branch_id], references: [id])
  destination_branch_id String
  destination_branch   MaintenanceBranch @relation("TransferDestination", fields: [destination_branch_id], references: [id])
  requested_by_id      String
  requested_by         MaintenanceAccount @relation("TransferRequester", fields: [requested_by_id], references: [id])
  reason               String
  status               TransferStatus @default(PENDING)
  response_reason      String?
  created_at           DateTime       @default(now())
  responded_at         DateTime?

  @@index([destination_branch_id, status, created_at])
  @@index([source_branch_id, status, created_at])
  @@index([ticket_id, status])
}

model MaintenanceAssignee {
  id              String   @id @default(cuid())
  name            String
  normalized_name String   @unique
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  current_tickets Ticket[]           @relation("CurrentTicketAssignee")
  assignments     TicketAssignment[]

  @@index([is_active, normalized_name])
}

model TicketAssignment {
  id          String             @id @default(cuid())
  ticket_id   String
  ticket      Ticket             @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  assignee_id String
  assignee    MaintenanceAssignee @relation(fields: [assignee_id], references: [id])
  assigned_by String
  assigned_at DateTime           @default(now())
  cleared_at  DateTime?

  @@index([ticket_id, assigned_at])
  @@index([assignee_id, cleared_at])
}

model TicketCost {
  id          String   @id @default(cuid())
  ticket_id   String
  ticket      Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  type        CostType
  description String
  amount      Decimal  @db.Decimal(10, 2)
  created_by  String
  created_at  DateTime @default(now())

  @@index([ticket_id, created_at])
  @@index([ticket_id, type])
}

model TicketActivity {
  id         String       @id @default(cuid())
  ticket_id  String
  ticket     Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  actor      String
  type       ActivityType
  detail     String
  created_at DateTime     @default(now())

  @@index([ticket_id, created_at])
}

model TicketStatusHistory {
  id         String       @id @default(cuid())
  ticket_id  String
  ticket     Ticket       @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  status     TicketStatus
  notes      String?
  created_at DateTime     @default(now())
}

model InventoryItem {
  id               String   @id @default(cuid())
  item_code        String   @unique
  name             String
  category_id      String
  category         Category @relation(fields: [category_id], references: [id])
  unit             String
  current_stock    Int      @default(0)
  reserved_stock   Int      @default(0)
  minimum_stock    Int      @default(0)
  unit_cost        Decimal  @db.Decimal(10, 2)
  supplier         String?
  storage_location String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  transactions     InventoryTransaction[]
  ticket_materials TicketMaterial[]
}

model TicketMaterial {
  id                String         @id @default(cuid())
  ticket_id         String
  ticket            Ticket         @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  inventory_item_id String
  inventory_item    InventoryItem  @relation(fields: [inventory_item_id], references: [id])
  quantity          Int
  unit_cost_at_time Decimal        @db.Decimal(10, 2)
  status            MaterialStatus @default(ADDED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model InventoryTransaction {
  id                String          @id @default(cuid())
  inventory_item_id String
  inventory_item    InventoryItem   @relation(fields: [inventory_item_id], references: [id])
  type              TransactionType
  quantity          Int
  ticket_id         String?
  notes             String?
  created_at        DateTime        @default(now())
}
