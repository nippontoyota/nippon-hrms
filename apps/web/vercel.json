{
  "ignoreCommand": "bash -c '[[ \"$(git log -1 --format=%ae)\" == \"dev@nippontoyota.com\" ]] || exit 1'",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nippon-hrms.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
