# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
APP_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only, never expose
SUPABASE_ANON_KEY=your-anon-key-here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=7

# ─── DoubleTick / WhatsApp Business ──────────────────────────────────────────
# Get these from: https://app.doubletick.io → Settings → API
DOUBLETICK_API_KEY=your-doubletick-api-key
# The verified WhatsApp phone number linked to your WABA (with country code)
WABA_PHONE_NUMBER_ID=+91XXXXXXXXXX
# Webhook secret from DoubleTick dashboard — used for HMAC-SHA256 verification
# Leave empty to disable signature verification during local development
DOUBLETICK_WEBHOOK_SECRET=
