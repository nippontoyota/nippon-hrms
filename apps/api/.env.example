# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
APP_ENV=development

# ─── Database (Direct Postgres Connection) ───────────────────────────────────
# Use port 5432 for the direct connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.urtbiaobabeyexsfdjhw.supabase.co:5432/postgres

# ─── Supabase (Storage & Auth API) ───────────────────────────────────────────
# Get these from: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://urtbiaobabeyexsfdjhw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only, never expose
SUPABASE_ANON_KEY=your-anon-key-here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=7

# ─── DoubleTick / WhatsApp Business ──────────────────────────────────────────
# Get these from: https://app.doubletick.io → Settings → API
DOUBLETICK_API_KEY=your-doubletick-api-key
WABA_PHONE_NUMBER_ID=+91XXXXXXXXXX
DOUBLETICK_WEBHOOK_SECRET=
